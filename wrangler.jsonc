{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "kompakt-www",
  "main": "src/worker.ts",
  "compatibility_date": "2026-05-19",
  "assets": {
    "binding": "ASSETS",
    "directory": "./dist",
    "run_worker_first": true
  },
  "routes": [
    {
      "pattern": "kompaktapp.com",
      "custom_domain": true
    },
    {
      "pattern": "www.kompaktapp.com",
      "custom_domain": true
    }
  ]
}
