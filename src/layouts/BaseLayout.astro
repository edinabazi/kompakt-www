---
import { site } from "../../site.config.mjs";
import "../styles/global.css";

const canonicalUrl = new URL("/", site.url).toString();
const ogImage = new URL(site.assets.ogImage, site.url).toString();
const structuredData = {
    "@context": "https://schema.org",
    "@graph": [
        {
            "@type": "WebSite",
            "@id": `${site.url}/#website`,
            url: canonicalUrl,
            name: site.name,
            description: site.description,
            inLanguage: "en",
        },
        {
            "@type": "SoftwareApplication",
            "@id": `${site.url}/#software`,
            name: site.name,
            applicationCategory: "MultimediaApplication",
            operatingSystem: "macOS",
            url: canonicalUrl,
            downloadUrl: site.downloadUrl,
            softwareVersion: "Latest",
            image: ogImage,
            description: site.description,
            offers: {
                "@type": "Offer",
                price: "0",
                priceCurrency: "USD",
            },
            sameAs: [site.githubUrl],
        },
    ],
};
const analyticsConfig = {
    posthogToken: "phc_o8KasS7p7xtGiey5D4nYMk9YSDLhqdwYvVfCKMtvEfuq",
    posthogApiHost: "https://s.playheadapp.com",
    datafastWebsiteId: "dfid_zKNTQ6kGOOkD9gKCvyZUs",
    datafastDomain: "kompaktapp.com",
};
---

<html lang="en">
    <head>
        <meta charset="utf-8" />
        <link rel="icon" type="image/png" sizes="224x224" href={site.assets.favicon} />
        <link rel="icon" sizes="any" href="/favicon.ico" />
        <link rel="apple-touch-icon" href={site.assets.favicon} />
        <meta name="viewport" content="width=device-width" />
        <meta name="description" content={site.description} />
        <meta name="robots" content="index,follow" />
        <meta name="theme-color" content={site.themeColor} />
        <link rel="canonical" href={canonicalUrl} />
        <link rel="manifest" href={site.assets.manifest} />

        <meta property="og:type" content="website" />
        <meta property="og:site_name" content={site.name} />
        <meta property="og:title" content={site.title} />
        <meta property="og:description" content={site.description} />
        <meta property="og:url" content={canonicalUrl} />
        <meta property="og:image" content={ogImage} />
        <meta property="og:image:width" content="1200" />
        <meta property="og:image:height" content="630" />

        <meta name="twitter:card" content="summary_large_image" />
        <meta name="twitter:title" content={site.title} />
        <meta name="twitter:description" content={site.description} />
        <meta name="twitter:image" content={ogImage} />

        <script
            type="application/ld+json"
            set:html={JSON.stringify(structuredData)}
        />
        <title>{site.title}</title>
        <script id="datafast-queue" is:inline>
            window.datafast =
                window.datafast ||
                function () {
                    window.datafast.q = window.datafast.q || [];
                    window.datafast.q.push(arguments);
                };
        </script>
        <script define:vars={{ analyticsConfig }} is:inline>
            if (analyticsConfig.datafastWebsiteId) {
                var datafastScript = document.createElement("script");
                datafastScript.defer = true;
                datafastScript.dataset.websiteId =
                    analyticsConfig.datafastWebsiteId;
                datafastScript.dataset.domain =
                    analyticsConfig.datafastDomain || "kompaktapp.com";
                datafastScript.src = "https://datafa.st/js/script.js";
                document.head.appendChild(datafastScript);
            }

            if (analyticsConfig.posthogToken) {
                !(function (t, e) {
                    var o, n, p, r;
                    e.__SV ||
                        ((window.posthog = e),
                        (e._i = []),
                        (e.init = function (i, s, a) {
                            function g(t, e) {
                                var o = e.split(".");
                                2 == o.length && ((t = t[o[0]]), (e = o[1])),
                                    (t[e] = function () {
                                        t.push(
                                            [e].concat(
                                                Array.prototype.slice.call(
                                                    arguments,
                                                    0,
                                                ),
                                            ),
                                        );
                                    });
                            }
                            ((p = t.createElement("script")).type =
                                "text/javascript"),
                                (p.async = !0),
                                (p.src = s.api_host + "/static/array.js"),
                                (r =
                                    t.getElementsByTagName(
                                        "script",
                                    )[0]).parentNode.insertBefore(p, r);
                            var u = e;
                            for (
                                void 0 !== a ? (u = e[a] = []) : (a = "posthog"),
                                    u.people = u.people || [],
                                    u.toString = function (t) {
                                        var e = "posthog";
                                        return (
                                            "posthog" !== a && (e += "." + a),
                                            t || (e += " (stub)"),
                                            e
                                        );
                                    },
                                    u.people.toString = function () {
                                        return u.toString(1) + ".people (stub)";
                                    },
                                    o =
                                        "capture identify alias people.set people.set_once set_config register register_once unregister opt_out_capturing has_opted_out_capturing opt_in_capturing reset isFeatureEnabled onFeatureFlags getFeatureFlag getFeatureFlagPayload reloadFeatureFlags group".split(
                                            " ",
                                        ),
                                    n = 0;
                                n < o.length;
                                n++
                            )
                                g(u, o[n]);
                            e._i.push([i, s, a]);
                        }),
                        (e.__SV = 1));
                })(document, window.posthog || []);

                posthog.init(analyticsConfig.posthogToken, {
                    api_host:
                        analyticsConfig.posthogApiHost ||
                        "https://s.playheadapp.com",
                    capture_pageview: true,
                    capture_pageleave: true,
                    autocapture: false,
                });
            }

            document.addEventListener("click", function (event) {
                var clickedElement =
                    event.target instanceof Element ? event.target : null;
                var target = clickedElement
                    ? clickedElement.closest("[data-analytics-event]")
                    : null;
                if (!target) return;

                var properties = {
                    target: target.dataset.analyticsTarget,
                    placement: target.dataset.analyticsPlacement,
                    href: target.href,
                };

                if (window.posthog) {
                    posthog.capture(target.dataset.analyticsEvent, properties);
                }

                if (typeof window.datafast === "function") {
                    window.datafast(target.dataset.analyticsEvent, properties);
                }
            });
        </script>
    </head>
    <body>
        <main
            class="flex min-h-screen flex-col items-center justify-center gap-[clamp(18px,3vw,34px)] px-[clamp(20px,4vw,56px)] py-[clamp(20px,4vw,56px)] max-[900px]:justify-start max-[900px]:px-3.5 max-[900px]:py-6"
        >
            <slot />
        </main>
    </body>
</html>
