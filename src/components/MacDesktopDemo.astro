---
const dockApps = [
    { name: "Finder", icon: "/dock-icons/finder-beta-2-liquid-glass.png" },
    { name: "Arc", icon: "/dock-icons/arc.png" },
    { name: "Settings", icon: "/dock-icons/settings.png" },
    { name: "Spotify", icon: "/dock-icons/spotify-liquid-glass-dark.png" },
];

const desktopFiles = [
    {
        name: "lake.jpg",
        thumbnail: "/desktop-examples/alpine-lake.jpg",
        preview: "/desktop-examples/lake-original.jpg",
        kind: "image",
        originalSize: 4.8,
        compressedSize: 2.9,
    },
    {
        name: "portrait.jpg",
        thumbnail: "/desktop-examples/city-portrait.jpg",
        preview: "/desktop-examples/portrait-original.jpg",
        kind: "image",
        originalSize: 7.2,
        compressedSize: 4.5,
    },
    {
        name: "studio.jpg",
        thumbnail: "/desktop-examples/studio-shot.jpg",
        preview: "/desktop-examples/studio-original.jpg",
        kind: "image",
        originalSize: 5.6,
        compressedSize: 3.6,
    },
    {
        name: "product.mp4",
        thumbnail: "/desktop-examples/product-reel.jpg",
        preview: "/desktop-examples/product-reel.mp4",
        kind: "video",
        originalSize: 42.4,
        compressedSize: 28.7,
    },
    {
        name: "launch.mp4",
        thumbnail: "/desktop-examples/launch-clip.jpg",
        preview: "/desktop-examples/launch-clip.mp4",
        kind: "video",
        originalSize: 24.8,
        compressedSize: 16.9,
    },
];
---

<div class="desktop-demo" aria-label="Mock macOS desktop">
    <div class="wallpaper" aria-hidden="true"></div>

    <div class="menu-bar">
        <div class="menu-left">
            <img
                class="apple-mark"
                src="/menu-icons/apple.logo.svg"
                alt=""
                draggable="false"
            />
            <strong>Kompakt</strong>
        </div>
        <div class="menu-right">
            <img
                class="menu-icon kompakt-menu-icon"
                src="/menu-icons/kompakt-menubar.svg"
                alt=""
                draggable="false"
            />
            <img
                class="menu-icon battery-icon"
                src="/menu-icons/battery.100percent.bolt.svg"
                alt=""
                draggable="false"
            />
            <img
                class="menu-icon wifi-icon"
                src="/menu-icons/wifi.svg"
                alt=""
                draggable="false"
            />
            <img
                class="menu-icon switch-icon"
                src="/menu-icons/switch.2.svg"
                alt=""
                draggable="false"
            />
            <time class="menu-clock" datetime="" data-menu-clock
                >Mon May 18 23:04</time
            >
        </div>
    </div>

    <div class="desktop-files" aria-label="Desktop files">
        {
            desktopFiles.map((file, index) => (
                <div
                    class:list={["desktop-file", `desktop-file-${index + 1}`]}
                    data-file-name={file.name}
                    data-file-kind={file.kind}
                    data-file-preview={file.preview}
                    data-original-size={file.originalSize}
                    data-compressed-size={file.compressedSize}
                    tabindex="0"
                    role="button"
                    aria-label={`${file.name} file`}
                >
                    <div class="file-thumbnail">
                        <img
                            src={file.thumbnail}
                            alt=""
                            loading="eager"
                            decoding="async"
                            draggable="false"
                        />
                        {file.kind === "video" && (
                            <span class="video-badge">▶</span>
                        )}
                    </div>
                    <span class="file-name">{file.name}</span>
                </div>
            ))
        }
    </div>

    <aside class="dropzone-demo" data-dropzone aria-hidden="true">
        <div class="dropzone-blur" aria-hidden="true"></div>
        <div class="dropzone-bloom" aria-hidden="true"></div>
        <div class="dropzone-center">
            <div class="dropzone-preview-stack" data-dropzone-previews></div>
            <div class="dropzone-title" data-dropzone-title>
                <span>Kompakt files</span>
            </div>
            <div
                class="dropzone-completion"
                data-dropzone-completion
                aria-hidden="true"
            >
                <strong data-completion-percent>0% smaller</strong>
                <span data-completion-size>0 MB -> 0 MB</span>
            </div>
            <div class="escape-hint">
                <kbd>ESC</kbd>
                <span>to hide</span>
            </div>
        </div>
    </aside>

    <div class="dock" aria-label="macOS Dock">
        {
            dockApps.map((app) => (
                <div
                    class:list={[
                        "dock-icon",
                        { kompakt: app.name === "Kompakt" },
                    ]}
                    title={app.name}
                >
                    {app.icon ? (
                        <img
                            src={app.icon}
                            alt=""
                            loading="eager"
                            decoding="async"
                            draggable="false"
                        />
                    ) : (
                        <span>{app.name[0]}</span>
                    )}
                </div>
            ))
        }
    </div>
</div>

<script>
    const clock = document.querySelector("[data-menu-clock]");
    const desktop = document.querySelector(".desktop-demo");
    const desktopFiles =
        document.querySelectorAll<HTMLElement>(".desktop-file");
    const dropzone = document.querySelector<HTMLElement>("[data-dropzone]");
    const dropzoneTitle = document.querySelector<HTMLElement>(
        "[data-dropzone-title]",
    );
    const dropzonePreviews = document.querySelector<HTMLElement>(
        "[data-dropzone-previews]",
    );
    const dropzoneCompletion = document.querySelector<HTMLElement>(
        "[data-dropzone-completion]",
    );
    const completionPercent = document.querySelector<HTMLElement>(
        "[data-completion-percent]",
    );
    const completionSize = document.querySelector<HTMLElement>(
        "[data-completion-size]",
    );
    let activePreview: HTMLElement | null = null;
    let activeDropFiles: HTMLElement[] = [];
    let dropzoneDismissTimer: number | undefined;
    let isDropzoneSuppressedForDrag = false;
    let currentDropzonePhase = "idle";
    let currentDropzoneTitle = "Kompakt files";
    let previewZIndex = 10;
    const successSound = new Audio("/sounds/success.mp3");
    successSound.volume = 0.5;
    successSound.preload = "auto";

    const formatMenuClock = (date: Date) => {
        const weekday = new Intl.DateTimeFormat(undefined, {
            weekday: "short",
        }).format(date);
        const month = new Intl.DateTimeFormat(undefined, {
            month: "short",
        }).format(date);
        const day = new Intl.DateTimeFormat(undefined, {
            day: "numeric",
        }).format(date);
        const time = new Intl.DateTimeFormat(undefined, {
            hour: "2-digit",
            minute: "2-digit",
            hour12: false,
        }).format(date);

        return `${weekday} ${month} ${day} ${time}`;
    };

    const updateMenuClock = () => {
        if (!(clock instanceof HTMLTimeElement)) return;

        const now = new Date();
        clock.textContent = formatMenuClock(now);
        clock.dateTime = now.toISOString();
    };

    updateMenuClock();
    setInterval(updateMenuClock, 30_000);

    const clearSelectedFiles = () => {
        desktopFiles.forEach((file) => {
            file.classList.remove("is-selected");
            file.setAttribute("aria-pressed", "false");
        });
    };

    const selectFile = (file: HTMLElement, additive = false) => {
        if (!additive) clearSelectedFiles();
        file.classList.add("is-selected");
        file.setAttribute("aria-pressed", "true");
    };

    const setFileSelected = (file: HTMLElement, selected: boolean) => {
        file.classList.toggle("is-selected", selected);
        file.setAttribute("aria-pressed", selected ? "true" : "false");
    };

    const closePreview = () => {
        activePreview?.remove();
        activePreview = null;
    };

    const getDesktopDragBounds = (element: HTMLElement) => {
        if (!(desktop instanceof HTMLElement)) {
            return { minLeft: 0, minTop: 0, maxLeft: 0, maxTop: 0 };
        }

        const menuBar = desktop.querySelector<HTMLElement>(".menu-bar");
        const dock = desktop.querySelector<HTMLElement>(".dock");
        const menuBottom = menuBar
            ? menuBar.offsetTop + menuBar.offsetHeight
            : 0;
        const dockTop = dock ? dock.offsetTop : desktop.clientHeight;
        const padding = 10;

        return {
            minLeft: padding,
            minTop: menuBottom + padding,
            maxLeft: desktop.clientWidth - element.offsetWidth - padding,
            maxTop: dockTop - element.offsetHeight - padding,
        };
    };

    const clampToDesktop = (
        element: HTMLElement,
        left: number,
        top: number,
    ) => {
        const bounds = getDesktopDragBounds(element);

        return {
            left: Math.max(bounds.minLeft, Math.min(bounds.maxLeft, left)),
            top: Math.max(bounds.minTop, Math.min(bounds.maxTop, top)),
        };
    };

    const intersects = (a: DOMRect, b: DOMRect) =>
        a.left < b.right &&
        a.right > b.left &&
        a.top < b.bottom &&
        a.bottom > b.top;

    const summarizeFiles = (files: HTMLElement[]) => {
        const count = files.length || 1;
        const kinds = new Set(
            files.map((file) => file.dataset.fileKind ?? "file"),
        );
        const kind = kinds.size === 1 ? [...kinds][0] : "file";
        const noun =
            kind === "image"
                ? count === 1
                    ? "image"
                    : "images"
                : kind === "video"
                  ? count === 1
                      ? "video"
                      : "videos"
                  : count === 1
                    ? "file"
                    : "files";

        return { count, noun };
    };

    const renderDropzonePreviews = (files: HTMLElement[]) => {
        if (!dropzonePreviews) return;

        dropzonePreviews.classList.remove("is-visible");
        dropzonePreviews.replaceChildren();
        dropzonePreviews.classList.toggle(
            "is-single-preview",
            files.length === 1,
        );

        files.slice(0, 3).forEach((file, index) => {
            const card = document.createElement("div");
            card.className = `dropzone-preview-card preview-card-${index + 1}`;

            const thumbnail = file.querySelector<HTMLImageElement>(
                ".file-thumbnail img",
            );
            if (thumbnail) {
                const image = document.createElement("img");
                image.src = thumbnail.src;
                image.alt = "";
                image.draggable = false;
                card.append(image);
            }

            if (file.dataset.fileKind === "video") {
                const badge = document.createElement("span");
                badge.textContent = "▶";
                card.append(badge);
            }

            dropzonePreviews.append(card);
        });

        if (files.length > 3) {
            const count = document.createElement("b");
            count.className = "dropzone-preview-count";
            count.textContent = `+${files.length - 3}`;
            dropzonePreviews.append(count);
        }
    };

    const formatMegabytes = (value: number) => {
        if (value >= 100) return `${Math.round(value)} MB`;
        return `${value.toFixed(1)} MB`;
    };

    const updateCompletionSummary = (files: HTMLElement[]) => {
        const originalSize = files.reduce(
            (total, file) => total + Number(file.dataset.originalSize ?? 0),
            0,
        );
        const compressedSize = files.reduce(
            (total, file) => total + Number(file.dataset.compressedSize ?? 0),
            0,
        );
        const percentSmaller =
            originalSize > 0
                ? Math.round(
                      ((originalSize - compressedSize) / originalSize) * 100,
                  )
                : 0;

        if (completionPercent) {
            completionPercent.textContent = `${percentSmaller}% smaller`;
        }

        if (completionSize) {
            completionSize.textContent = `${formatMegabytes(originalSize)} -> ${formatMegabytes(compressedSize)}`;
        }
    };

    const playSuccessSound = () => {
        successSound.currentTime = 0;
        void successSound.play().catch(() => {
            // Browsers can block sound until the first user gesture; this demo is gesture-driven.
        });
    };

    const createDropzoneTitleNode = (text: string, isThinking = false) => {
        const node = document.createElement("span");

        if (!isThinking) {
            node.textContent = text;
            return node;
        }

        node.className = "thinking-title";

        const base = document.createElement("span");
        base.className = "thinking-title-base";
        base.textContent = text;

        const shine = document.createElement("span");
        shine.className = "thinking-title-shine";
        shine.textContent = text;

        node.append(base, shine);
        return node;
    };

    const setDropzoneTitle = (text: string, isThinking = false) => {
        if (!dropzoneTitle || text === currentDropzoneTitle) return;

        currentDropzoneTitle = text;

        const previous = dropzoneTitle.lastElementChild as HTMLElement | null;
        previous?.classList.add("is-exiting");

        const next = createDropzoneTitleNode(text, isThinking);
        next.className = "is-entering";
        if (isThinking) next.classList.add("thinking-title");
        dropzoneTitle.append(next);

        requestAnimationFrame(() => {
            next.classList.remove("is-entering");
        });

        previous?.addEventListener("animationend", () => previous.remove(), {
            once: true,
        });
        window.setTimeout(() => previous?.remove(), 380);
    };

    const setDropzonePhase = (
        phase: "idle" | "targeted" | "processing" | "finished",
        files = activeDropFiles,
    ) => {
        if (!dropzone || !dropzoneTitle || !dropzoneCompletion) return;

        const summary = summarizeFiles(files);
        const oldPhase = currentDropzonePhase;
        currentDropzonePhase = phase;
        dropzone.dataset.phase = phase;
        dropzoneCompletion.setAttribute(
            "aria-hidden",
            phase === "finished" ? "false" : "true",
        );

        const shouldShowPreview =
            phase === "processing" || phase === "finished";
        dropzonePreviews?.toggleAttribute("hidden", !shouldShowPreview);
        requestAnimationFrame(() => {
            dropzonePreviews?.classList.toggle("is-visible", shouldShowPreview);
        });

        if (phase === "processing") {
            setDropzoneTitle(`Kompakting ${summary.noun}`, true);
        } else if (phase === "finished") {
            setDropzoneTitle("");
        } else {
            setDropzoneTitle(`Kompakt ${summary.noun}`);
        }

        if (oldPhase !== phase && phase === "finished") {
            playSuccessSound();
            dropzoneCompletion.classList.remove("is-visible");
            window.setTimeout(() => {
                dropzoneCompletion.classList.add("is-visible");
            }, 80);
        } else if (phase !== "finished") {
            dropzoneCompletion.classList.remove("is-visible");
        }
    };

    const showDropzone = (files: HTMLElement[]) => {
        if (!dropzone) return;
        if (isDropzoneSuppressedForDrag) return;

        window.clearTimeout(dropzoneDismissTimer);
        activeDropFiles = files;
        dropzone.classList.add("is-visible");
        dropzone.setAttribute("aria-hidden", "false");
        renderDropzonePreviews(files);
        setDropzonePhase("idle", files);
    };

    const hideDropzone = () => {
        if (!dropzone) return;

        activeDropFiles = [];
        dropzone.classList.remove("is-visible", "is-targeted");
        dropzone.setAttribute("aria-hidden", "true");
        dropzone.dataset.phase = "idle";
        currentDropzonePhase = "idle";
        currentDropzoneTitle = "Kompakt files";
        if (dropzoneTitle) {
            dropzoneTitle.replaceChildren();
            const title = document.createElement("span");
            title.textContent = currentDropzoneTitle;
            dropzoneTitle.append(title);
        }
        dropzonePreviews?.classList.remove("is-visible");
        dropzoneCompletion?.classList.remove("is-visible");
        dropzoneCompletion?.setAttribute("aria-hidden", "true");
        window.clearTimeout(dropzoneDismissTimer);
    };

    const isOverDropzone = (event: PointerEvent) => {
        if (!dropzone?.classList.contains("is-visible")) return false;

        const rect = dropzone.getBoundingClientRect();
        return (
            event.clientX >= rect.left &&
            event.clientX <= rect.right &&
            event.clientY >= rect.top &&
            event.clientY <= rect.bottom
        );
    };

    const updateDropzoneTarget = (event: PointerEvent) => {
        if (!dropzone?.classList.contains("is-visible")) return;

        const targeted = isOverDropzone(event);
        dropzone.classList.toggle("is-targeted", targeted);
        if (targeted && dropzoneTitle) {
            const rect = dropzone.getBoundingClientRect();
            const normalizedX =
                ((event.clientX - rect.left) / Math.max(rect.width, 1) - 0.5) *
                2;
            const normalizedY =
                ((event.clientY - rect.top) / Math.max(rect.height, 1) - 0.5) *
                2;
            const offsetX = normalizedX * 38 + Math.max(0, normalizedX) * 8;
            const offsetY = normalizedY * 32;

            dropzoneTitle.style.setProperty("--magnet-x", `${offsetX}px`);
            dropzoneTitle.style.setProperty("--magnet-y", `${offsetY}px`);
        } else if (dropzoneTitle) {
            dropzoneTitle.style.setProperty("--magnet-x", "0px");
            dropzoneTitle.style.setProperty("--magnet-y", "0px");
        }
        setDropzonePhase(targeted ? "targeted" : "idle");
    };

    const simulateDropzoneCompression = (files: HTMLElement[]) => {
        if (!dropzone) return;
        if (isDropzoneSuppressedForDrag) return;

        dropzone.classList.remove("is-targeted");
        dropzoneTitle?.style.setProperty("--magnet-x", "0px");
        dropzoneTitle?.style.setProperty("--magnet-y", "0px");
        renderDropzonePreviews(files);
        updateCompletionSummary(files);
        setDropzonePhase("processing", files);

        window.clearTimeout(dropzoneDismissTimer);
        dropzoneDismissTimer = window.setTimeout(() => {
            setDropzonePhase("finished", files);

            dropzoneDismissTimer = window.setTimeout(() => {
                hideDropzone();
            }, 2400);
        }, 2900);
    };

    const getMediaSize = (source: HTMLImageElement | HTMLVideoElement) => {
        if (source instanceof HTMLImageElement) {
            return {
                width: source.naturalWidth || 900,
                height: source.naturalHeight || 600,
            };
        }

        return {
            width: source.videoWidth || 720,
            height: source.videoHeight || 960,
        };
    };

    const waitForMediaSize = (source: HTMLImageElement | HTMLVideoElement) =>
        new Promise<{ width: number; height: number }>((resolve) => {
            const finish = () => resolve(getMediaSize(source));

            if (
                source instanceof HTMLImageElement &&
                source.complete &&
                source.naturalWidth
            ) {
                finish();
                return;
            }

            if (
                source instanceof HTMLVideoElement &&
                source.readyState >= 1 &&
                source.videoWidth
            ) {
                finish();
                return;
            }

            source.addEventListener(
                source instanceof HTMLImageElement ? "load" : "loadedmetadata",
                finish,
                {
                    once: true,
                },
            );
            source.addEventListener(
                "error",
                () => resolve({ width: 900, height: 600 }),
                { once: true },
            );
        });

    const openPreview = async (file: HTMLElement) => {
        if (!(desktop instanceof HTMLElement)) return;

        const name = file.dataset.fileName ?? "Preview";
        const kind = file.dataset.fileKind ?? "image";
        const preview = file.dataset.filePreview;

        if (!preview) return;

        closePreview();

        const previewWindow = document.createElement("section");
        previewWindow.className = "preview-window";
        previewWindow.style.visibility = "hidden";
        previewWindow.style.zIndex = String(previewZIndex++);
        previewWindow.setAttribute("aria-label", `${name} preview`);

        const chrome = document.createElement("div");
        chrome.className = "preview-chrome";

        const controls = document.createElement("div");
        controls.className = "preview-controls";
        const closeButton = document.createElement("button");
        closeButton.className = "preview-close";
        closeButton.type = "button";
        closeButton.setAttribute("aria-label", "Close preview");
        closeButton.addEventListener("pointerdown", (event) =>
            event.stopPropagation(),
        );
        closeButton.addEventListener("click", (event) => {
            event.stopPropagation();
            closePreview();
        });

        const minimizeButton = document.createElement("button");
        minimizeButton.type = "button";
        minimizeButton.disabled = true;
        minimizeButton.setAttribute("aria-label", "Minimize disabled");

        const zoomButton = document.createElement("button");
        zoomButton.type = "button";
        zoomButton.disabled = true;
        zoomButton.setAttribute("aria-label", "Zoom disabled");

        controls.append(closeButton, minimizeButton, zoomButton);

        const title = document.createElement("span");
        title.className = "preview-title";
        title.textContent = name;

        chrome.append(controls, title);

        const mediaWrap = document.createElement("div");
        mediaWrap.className = "preview-media";

        let mediaElement: HTMLImageElement | HTMLVideoElement;

        if (kind === "video") {
            const video = document.createElement("video");
            video.src = preview;
            video.controls = true;
            video.autoplay = true;
            video.muted = true;
            video.playsInline = true;
            mediaWrap.append(video);
            mediaElement = video;
        } else {
            const image = document.createElement("img");
            image.src = preview;
            image.alt = "";
            mediaWrap.append(image);
            mediaElement = image;
        }

        previewWindow.append(chrome, mediaWrap);
        desktop.append(previewWindow);
        activePreview = previewWindow;

        const mediaSize = await waitForMediaSize(mediaElement);
        if (activePreview !== previewWindow) return;

        const chromeHeight = chrome.offsetHeight || 38;
        const maxMediaWidth = Math.min(620, desktop.clientWidth * 0.46);
        const maxMediaHeight = Math.min(390, desktop.clientHeight * 0.42);
        const scale = Math.min(
            maxMediaWidth / mediaSize.width,
            maxMediaHeight / mediaSize.height,
            1,
        );
        const mediaWidth = Math.round(mediaSize.width * scale);
        const mediaHeight = Math.round(mediaSize.height * scale);

        previewWindow.style.width = `${mediaWidth}px`;
        mediaWrap.style.width = `${mediaWidth}px`;
        mediaWrap.style.height = `${mediaHeight}px`;

        const centered = clampToDesktop(
            previewWindow,
            (desktop.clientWidth - previewWindow.offsetWidth) / 2,
            (desktop.clientHeight - previewWindow.offsetHeight) / 2,
        );

        previewWindow.style.left = `${centered.left}px`;
        previewWindow.style.top = `${centered.top}px`;
        previewWindow.style.transform = "none";

        const fileRect = file.getBoundingClientRect();
        const desktopRect = desktop.getBoundingClientRect();
        const originX =
            fileRect.left -
            desktopRect.left +
            fileRect.width / 2 -
            centered.left;
        const originY =
            fileRect.top - desktopRect.top + fileRect.height / 2 - centered.top;

        previewWindow.style.setProperty("--preview-origin-x", `${originX}px`);
        previewWindow.style.setProperty("--preview-origin-y", `${originY}px`);
        previewWindow.style.visibility = "visible";
        previewWindow.classList.add("is-opening");
        previewWindow.addEventListener(
            "animationend",
            () => previewWindow.classList.remove("is-opening"),
            { once: true },
        );

        if (mediaElement instanceof HTMLVideoElement) {
            void mediaElement.play().catch(() => {});
        }

        makePreviewDraggable(previewWindow, chrome);
    };

    const makePreviewDraggable = (
        previewWindow: HTMLElement,
        handle: HTMLElement,
    ) => {
        handle.addEventListener("pointerdown", (event) => {
            if (
                event.target instanceof HTMLElement &&
                event.target.closest(".preview-controls")
            )
                return;

            const pointerEvent = event as PointerEvent;
            handle.setPointerCapture(pointerEvent.pointerId);

            const startX = pointerEvent.clientX;
            const startY = pointerEvent.clientY;
            const startLeft = previewWindow.offsetLeft;
            const startTop = previewWindow.offsetTop;

            const movePreview = (moveEvent: PointerEvent) => {
                const position = clampToDesktop(
                    previewWindow,
                    startLeft + moveEvent.clientX - startX,
                    startTop + moveEvent.clientY - startY,
                );

                previewWindow.style.left = `${position.left}px`;
                previewWindow.style.top = `${position.top}px`;
                previewWindow.style.transform = "none";
            };

            const stopMove = () => {
                previewWindow.removeEventListener("pointermove", movePreview);
                previewWindow.removeEventListener("pointerup", stopMove);
                previewWindow.removeEventListener("pointercancel", stopMove);
            };

            previewWindow.addEventListener("pointermove", movePreview);
            previewWindow.addEventListener("pointerup", stopMove);
            previewWindow.addEventListener("pointercancel", stopMove);
        });
    };

    desktop?.addEventListener("pointerdown", (event) => {
        if (!(desktop instanceof HTMLElement) || event.button !== 0) return;

        const target = event.target;
        const startedOnDesktop =
            target instanceof HTMLElement &&
            !target.closest(".desktop-file, .dock, .menu-bar, .preview-window");

        if (!startedOnDesktop) return;

        const pointerEvent = event as PointerEvent;
        const desktopRect = desktop.getBoundingClientRect();
        const bounds = getDesktopDragBounds(document.createElement("div"));
        const startLeft = Math.max(
            bounds.minLeft,
            Math.min(bounds.maxLeft, pointerEvent.clientX - desktopRect.left),
        );
        const startTop = Math.max(
            bounds.minTop,
            Math.min(bounds.maxTop, pointerEvent.clientY - desktopRect.top),
        );
        const additive =
            pointerEvent.metaKey ||
            pointerEvent.ctrlKey ||
            pointerEvent.shiftKey;
        const initiallySelected = new Set(
            Array.from(desktopFiles).filter((file) =>
                file.classList.contains("is-selected"),
            ),
        );

        if (!additive) clearSelectedFiles();

        const marquee = document.createElement("div");
        marquee.className = "selection-marquee";
        marquee.style.left = `${startLeft}px`;
        marquee.style.top = `${startTop}px`;
        desktop.append(marquee);

        if (target instanceof HTMLElement) {
            target.setPointerCapture(pointerEvent.pointerId);
        }

        const updateMarquee = (moveEvent: PointerEvent) => {
            const currentLeft = Math.max(
                bounds.minLeft,
                Math.min(bounds.maxLeft, moveEvent.clientX - desktopRect.left),
            );
            const currentTop = Math.max(
                bounds.minTop,
                Math.min(bounds.maxTop, moveEvent.clientY - desktopRect.top),
            );
            const left = Math.min(startLeft, currentLeft);
            const top = Math.min(startTop, currentTop);
            const width = Math.abs(currentLeft - startLeft);
            const height = Math.abs(currentTop - startTop);

            marquee.style.left = `${left}px`;
            marquee.style.top = `${top}px`;
            marquee.style.width = `${width}px`;
            marquee.style.height = `${height}px`;

            const marqueeRect = marquee.getBoundingClientRect();

            desktopFiles.forEach((file) => {
                const shouldSelect = intersects(
                    marqueeRect,
                    file.getBoundingClientRect(),
                );
                setFileSelected(
                    file,
                    shouldSelect || (additive && initiallySelected.has(file)),
                );
            });
        };

        const stopMarquee = () => {
            window.removeEventListener("pointermove", updateMarquee);
            window.removeEventListener("pointerup", stopMarquee);
            window.removeEventListener("pointercancel", stopMarquee);
            marquee.classList.add("is-closing");
            marquee.addEventListener("transitionend", () => marquee.remove(), {
                once: true,
            });
            window.setTimeout(() => marquee.remove(), 180);
        };

        window.addEventListener("pointermove", updateMarquee);
        window.addEventListener("pointerup", stopMarquee);
        window.addEventListener("pointercancel", stopMarquee);
    });

    window.addEventListener("keydown", (event) => {
        if (event.key === "Escape") {
            isDropzoneSuppressedForDrag = true;
            hideDropzone();
        }
    });

    desktopFiles.forEach((file) => {
        let didDrag = false;

        file.setAttribute("aria-pressed", "false");

        file.addEventListener("click", (event) => {
            if (didDrag) {
                didDrag = false;
                return;
            }

            selectFile(file, event.metaKey || event.ctrlKey || event.shiftKey);
        });

        file.addEventListener("dblclick", () => {
            selectFile(file);
            openPreview(file);
        });

        file.addEventListener("keydown", (event) => {
            if (event.key === "Enter" || event.key === " ") {
                event.preventDefault();
                selectFile(file);
                openPreview(file);
            }
        });

        file.addEventListener("pointerdown", (event) => {
            if (event.button !== 0) return;

            const pointerEvent = event as PointerEvent;
            if (!(desktop instanceof HTMLElement)) return;

            pointerEvent.preventDefault();
            file.setPointerCapture(pointerEvent.pointerId);

            const startX = pointerEvent.clientX;
            const startY = pointerEvent.clientY;
            const desktopRect = desktop.getBoundingClientRect();
            const shouldDragSelection = file.classList.contains("is-selected");
            const draggedFiles = shouldDragSelection
                ? Array.from(desktopFiles).filter((desktopFile) =>
                      desktopFile.classList.contains("is-selected"),
                  )
                : [file];
            const dragStarts = draggedFiles.map((draggedFile) => {
                const rect = draggedFile.getBoundingClientRect();
                const left = rect.left - desktopRect.left;
                const top = rect.top - desktopRect.top;

                draggedFile.style.left = `${left}px`;
                draggedFile.style.top = `${top}px`;

                return { file: draggedFile, left, top };
            });
            let dragProxies: HTMLElement[] = [];
            const selectionBounds = dragStarts.reduce(
                (bounds, item) => ({
                    minDeltaX: Math.max(
                        bounds.minDeltaX,
                        getDesktopDragBounds(item.file).minLeft - item.left,
                    ),
                    maxDeltaX: Math.min(
                        bounds.maxDeltaX,
                        getDesktopDragBounds(item.file).maxLeft - item.left,
                    ),
                    minDeltaY: Math.max(
                        bounds.minDeltaY,
                        getDesktopDragBounds(item.file).minTop - item.top,
                    ),
                    maxDeltaY: Math.min(
                        bounds.maxDeltaY,
                        getDesktopDragBounds(item.file).maxTop - item.top,
                    ),
                }),
                {
                    minDeltaX: Number.NEGATIVE_INFINITY,
                    maxDeltaX: Number.POSITIVE_INFINITY,
                    minDeltaY: Number.NEGATIVE_INFINITY,
                    maxDeltaY: Number.POSITIVE_INFINITY,
                },
            );

            const ensureDragProxies = () => {
                if (dragProxies.length > 0) return;

                dragProxies = dragStarts.map((item) => {
                    const proxy = item.file.cloneNode(true) as HTMLElement;
                    proxy.classList.add("drag-proxy");
                    proxy.classList.remove("is-selected", "is-dragging");
                    proxy.removeAttribute("id");
                    proxy.removeAttribute("role");
                    proxy.removeAttribute("tabindex");
                    proxy.setAttribute("aria-hidden", "true");
                    proxy.style.left = `${item.left}px`;
                    proxy.style.top = `${item.top}px`;
                    desktop.append(proxy);
                    return proxy;
                });
            };

            const removeDragProxies = () => {
                dragProxies.forEach((proxy) => proxy.remove());
                dragProxies = [];
            };

            const animateDragProxiesHome = (onFinished: () => void) => {
                if (dragProxies.length === 0) {
                    onFinished();
                    return;
                }

                let remaining = dragProxies.length;

                dragProxies.forEach((proxy, index) => {
                    const start = dragStarts[index];
                    if (!start) return;
                    let finished = false;

                    proxy.classList.add("is-returning");
                    proxy.style.left = `${start.left}px`;
                    proxy.style.top = `${start.top}px`;

                    const finish = () => {
                        if (finished) return;
                        finished = true;
                        remaining -= 1;
                        if (remaining === 0) {
                            removeDragProxies();
                            onFinished();
                        }
                    };

                    proxy.addEventListener("transitionend", finish, {
                        once: true,
                    });
                    window.setTimeout(finish, 220);
                });
            };

            if (!shouldDragSelection) {
                selectFile(
                    file,
                    pointerEvent.metaKey ||
                        pointerEvent.ctrlKey ||
                        pointerEvent.shiftKey,
                );
            }

            const releasePointer = () => {
                if (file.hasPointerCapture(pointerEvent.pointerId)) {
                    file.releasePointerCapture(pointerEvent.pointerId);
                }
            };

            const cleanupDragListeners = () => {
                window.removeEventListener("pointermove", moveFile);
                window.removeEventListener("pointerup", stopWithDrop);
                window.removeEventListener("pointercancel", cancelMove);
                file.removeEventListener("lostpointercapture", cancelMove);
                releasePointer();
            };

            const moveFile = (moveEvent: PointerEvent) => {
                if (moveEvent.pointerId !== pointerEvent.pointerId) return;
                moveEvent.preventDefault();

                const rawDeltaX = moveEvent.clientX - startX;
                const rawDeltaY = moveEvent.clientY - startY;
                const deltaX = Math.max(
                    selectionBounds.minDeltaX,
                    Math.min(selectionBounds.maxDeltaX, rawDeltaX),
                );
                const deltaY = Math.max(
                    selectionBounds.minDeltaY,
                    Math.min(selectionBounds.maxDeltaY, rawDeltaY),
                );

                if (Math.abs(rawDeltaX) + Math.abs(rawDeltaY) > 4) {
                    didDrag = true;
                    ensureDragProxies();
                    draggedFiles.forEach((draggedFile) =>
                        draggedFile.classList.add("is-dragging"),
                    );
                    showDropzone(draggedFiles);
                    updateDropzoneTarget(moveEvent);
                }

                dragStarts.forEach((item, index) => {
                    const proxy = dragProxies[index];
                    if (!proxy) return;

                    proxy.style.left = `${item.left + deltaX}px`;
                    proxy.style.top = `${item.top + deltaY}px`;
                });
            };

            const stopWithDrop = (upEvent: PointerEvent) => {
                if (upEvent.pointerId !== pointerEvent.pointerId) return;

                const droppedOnDropzone = didDrag && isOverDropzone(upEvent);
                draggedFiles.forEach((draggedFile) =>
                    draggedFile.classList.remove("is-dragging"),
                );
                cleanupDragListeners();

                if (droppedOnDropzone) {
                    animateDragProxiesHome(() => {
                        simulateDropzoneCompression(draggedFiles);
                    });
                } else if (didDrag) {
                    dragStarts.forEach((item, index) => {
                        const proxy = dragProxies[index];
                        if (!proxy) return;

                        item.file.style.left = proxy.style.left;
                        item.file.style.top = proxy.style.top;
                    });
                    removeDragProxies();
                    window.setTimeout(hideDropzone, 150);
                }

                isDropzoneSuppressedForDrag = false;
            };

            const cancelMove = (cancelEvent?: PointerEvent) => {
                if (
                    cancelEvent instanceof PointerEvent &&
                    cancelEvent.pointerId !== pointerEvent.pointerId
                ) {
                    return;
                }

                draggedFiles.forEach((draggedFile) =>
                    draggedFile.classList.remove("is-dragging"),
                );
                cleanupDragListeners();
                removeDragProxies();
                if (didDrag) window.setTimeout(hideDropzone, 150);
                isDropzoneSuppressedForDrag = false;
            };

            window.addEventListener("pointermove", moveFile);
            window.addEventListener("pointerup", stopWithDrop);
            window.addEventListener("pointercancel", cancelMove);
            file.addEventListener("lostpointercapture", cancelMove);
        });
    });
</script>

