---
import { site } from "../../site.config.mjs";
import MacDesktopDemo from "./MacDesktopDemo.astro";

const buttonBase =
    "group relative flex min-h-[64px] items-center justify-center overflow-hidden rounded-3xl px-7 py-4 text-[clamp(15px,1.45vw,20px)] leading-none font-medium tracking-[-0.03em] whitespace-nowrap no-underline [corner-shape:squircle] transition duration-300 ease-out hover:opacity-95 active:scale-[0.99]";
---

<section class="flex w-full max-w-[1728px] flex-col items-center px-5">
    <div
        class="mb-10 flex items-center sm:mb-16"
        data-motion="soft"
        data-motion-load
        style="--motion-delay: 40ms;"
    >
        <a href="/" aria-label={`${site.name} home`} class="block">
            <img
                src="/brand/logo-full.png"
                alt={site.name}
                width="230"
                height="64"
                class="h-16 w-auto"
            />
        </a>
    </div>

    <div
        class="mx-auto max-w-5xl text-center"
        data-motion="soft"
        data-motion-load
        style="--motion-delay: 180ms;"
    >
        <h1
            class="text-[10.5vw] leading-[0.9] font-bold tracking-[-0.04em] text-[#142247] sm:text-6xl lg:text-[64px]"
        >
            Optimize your files
            <br class="hidden sm:inline" />
            <span class="inline sm:hidden">&nbsp;</span>
            with a single drag.
        </h1>
        <p
            class="mx-auto mt-6 max-w-[720px] text-base leading-[1.36] font-medium tracking-[-0.02em] text-[#4b4b3d] sm:text-lg"
        >
            Kompakt is a <span class="italic">compact</span> Mac app that makes it
            dead-simple to compress your images and videos. <br
                class="hidden md:inline"
            />
            It stays out of your way until you need it. The moment you drag an image,
            it pops up to help you out.
        </p>
    </div>

    <div
        class="relative z-30 mt-8 flex flex-wrap justify-center gap-3 max-[529px]:w-full max-[529px]:flex-col sm:items-start"
        data-motion="soft"
        data-motion-load
        style="--motion-delay: 320ms;"
    >
        <a
            class={`${buttonBase} bg-linear-to-b from-[#3c72f2] to-[#0042cf] text-[#e9fffa] max-[529px]:w-full`}
            href={site.downloadUrl}
            data-analytics-event="download_button_clicked"
            data-analytics-target="macos"
            data-analytics-placement="hero"
        >
            <span
                class="inline-flex translate-x-0 items-center gap-2.5 transition duration-300 ease-out group-hover:-translate-x-8"
            >
                <span
                    class="shrink-0 translate-x-0 opacity-100 transition duration-300 ease-out group-hover:-translate-x-full group-hover:scale-x-50 group-hover:opacity-0 group-hover:blur-sm"
                >
                    <img
                        class="block h-[25px] w-[19px] -translate-y-[3px] object-contain"
                        src={site.assets.appleIcon}
                        alt=""
                    />
                </span>
                <span>Download for Mac</span>
            </span>
            <svg
                class="pointer-events-none absolute right-7 size-6 translate-x-full scale-x-50 opacity-0 blur-sm transition duration-300 ease-out group-hover:translate-x-0 group-hover:scale-x-100 group-hover:opacity-100 group-hover:blur-none"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
            >
                <path
                    d="M5 12h14m-6-6 6 6-6 6"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
            </svg>
        </a>

        <a
            class={`${buttonBase} border-2 border-[#1041c7] bg-white/20 text-[#1041c7] max-[529px]:w-full`}
            href={site.githubUrl}
            data-analytics-event="github_button_clicked"
            data-analytics-target="github"
            data-analytics-placement="hero"
        >
            <span
                class="inline-flex translate-x-0 items-center gap-2.5 transition duration-300 ease-out group-hover:-translate-x-8"
            >
                <span
                    class="shrink-0 translate-x-0 opacity-100 transition duration-300 ease-out group-hover:-translate-x-full group-hover:scale-x-50 group-hover:opacity-0 group-hover:blur-sm"
                >
                    <img
                        class="block size-[22px] object-contain"
                        src={site.assets.githubIcon}
                        alt=""
                    />
                </span>
                <span>View on GitHub</span>
            </span>
            <svg
                class="pointer-events-none absolute right-7 size-6 translate-x-full scale-x-50 opacity-0 blur-sm transition duration-300 ease-out group-hover:translate-x-0 group-hover:scale-x-100 group-hover:opacity-100 group-hover:blur-none"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
            >
                <path
                    d="M5 12h14m-6-6 6 6-6 6"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
            </svg>
        </a>
    </div>

    <div
        class="relative mt-4 w-[min(80vw,1440px)] max-[1500px]:w-[90vw] max-[900px]:w-full sm:mt-14"
        data-motion="hero-demo"
        data-motion-load
        style="--motion-delay: 420ms;"
    >
        <div class="demo-callout" aria-hidden="true">
            <span>Interactive demo</span>
            <svg viewBox="0 0 132 112" fill="none" focusable="false">
                <mask
                    id="demo-callout-arrow-mask"
                    maskUnits="userSpaceOnUse"
                    x="0"
                    y="0"
                    width="132"
                    height="112"
                >
                    <rect
                        class="demo-callout-mask"
                        x="0"
                        y="0"
                        width="132"
                        height="112"
                        fill="white"></rect>
                </mask>
                <g mask="url(#demo-callout-arrow-mask)">
                    <path
                        d="M119 7C110 41 82 72 34 89"
                        stroke="currentColor"
                        stroke-width="5"
                        stroke-linecap="round"></path>
                    <path
                        d="M38 66C31 76 24 86 15 101C30 98 44 96 58 98"
                        stroke="currentColor"
                        stroke-width="5"
                        stroke-linecap="round"
                        stroke-linejoin="round"></path>
                </g>
            </svg>
        </div>
        <MacDesktopDemo />
    </div>
</section>

<style>
    .demo-callout {
        position: absolute;
        top: -178px;
        right: 0;
        z-index: 4;
        display: grid;
        justify-items: end;
        color: #1041c7;
        pointer-events: none;
        transform: translateX(10px) rotate(4deg);
    }

    .demo-callout span {
        max-width: 172px;
        opacity: 0;
        transform: translateY(6px) rotate(3deg);
        font-size: clamp(19px, 1.9vw, 24px);
        line-height: 0.92;
        font-weight: 600;
        letter-spacing: -0.045em;
        text-align: right;
        margin-bottom: 8px;
    }

    .is-visible .demo-callout span {
        animation: demo-callout-text-in 420ms cubic-bezier(0.16, 1, 0.3, 1)
            2260ms both;
    }

    .demo-callout svg {
        width: clamp(82px, 8vw, 132px);
        height: auto;
        margin-top: 0;
        margin-right: 42px;
        transform: rotate(-24deg) translateX(9px) translateY(24px);
        overflow: visible;
    }

    .demo-callout-mask {
        transform: scaleY(0);
        transform-box: fill-box;
        transform-origin: top;
    }

    .is-visible .demo-callout-mask {
        animation: demo-callout-arrow-reveal 680ms cubic-bezier(0.16, 1, 0.3, 1)
            1540ms both;
    }

    @keyframes demo-callout-arrow-reveal {
        to {
            transform: scaleY(1);
        }
    }

    @keyframes demo-callout-text-in {
        to {
            opacity: 1;
            transform: translateY(0) rotate(3deg);
        }
    }

    @media (prefers-reduced-motion: reduce) {
        .demo-callout span {
            opacity: 1;
            transform: rotate(3deg);
        }

        .demo-callout-mask {
            transform: none;
        }

        .is-visible .demo-callout span,
        .is-visible .demo-callout-mask {
            animation: none;
        }
    }

    @media (max-width: 1099px) {
        .demo-callout {
            display: none;
        }
    }

    @media (max-width: 900px) {
        .demo-callout {
            top: -124px;
            right: 18px;
        }

        .demo-callout span {
            max-width: 126px;
            font-size: 18px;
        }

        .demo-callout svg {
            width: 74px;
            margin-right: 28px;
        }
    }

    @media (max-width: 620px) {
        .demo-callout {
            top: -88px;
            right: 10px;
        }

        .demo-callout span {
            font-size: 14px;
            letter-spacing: -0.03em;
        }

        .demo-callout svg {
            width: 52px;
            margin-right: 20px;
            stroke-width: 4;
        }
    }
</style>
