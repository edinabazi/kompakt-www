---
import { site } from "../../site.config.mjs";
import MacDesktopDemo from "./MacDesktopDemo.astro";

const buttonBase =
    "group relative flex min-h-[64px] items-center justify-center overflow-hidden rounded-3xl px-7 py-4 text-[clamp(15px,1.45vw,20px)] leading-none font-medium tracking-[-0.03em] whitespace-nowrap no-underline [corner-shape:squircle] transition duration-300 ease-out hover:opacity-95 active:scale-[0.99]";
---

<section class="flex w-full max-w-[1728px] flex-col items-center px-5">
    <div class="mb-10 flex items-center sm:mb-16">
        <a href="/" aria-label={`${site.name} home`} class="block">
            <img
                src="/brand/logo-full.png"
                alt={site.name}
                width="230"
                height="64"
                class="h-16 w-auto"
            />
        </a>
    </div>

    <div class="mx-auto max-w-5xl text-center">
        <h1
            class="text-[10.5vw] leading-[0.9] font-bold tracking-[-0.04em] text-[#142247] sm:text-6xl lg:text-[64px]"
        >
            Optimize your files
            <br class="hidden sm:inline" />
            <span class="inline sm:hidden">&nbsp;</span>
            with a single drag.
        </h1>
        <p
            class="mx-auto mt-6 max-w-[720px] text-base leading-[1.36] font-medium tracking-[-0.02em] text-[#4b4b3d] sm:text-lg"
        >
            Kompakt is a <span class="italic">compact</span> Mac app that makes it
            dead-simple to compress your images and videos. <br
                class="hidden md:inline"
            />
            It stays out of your way until you need it. The moment you drag an image,
            it pops up to help you out.
        </p>
    </div>

    <div
        class="relative z-30 mt-8 flex flex-wrap justify-center gap-3 max-[529px]:w-full max-[529px]:flex-col sm:items-start"
    >
        <a
            class={`${buttonBase} bg-linear-to-b from-[#3c72f2] to-[#0042cf] text-[#e9fffa] max-[529px]:w-full`}
            href={site.downloadUrl}
            data-analytics-event="download_button_clicked"
            data-analytics-target="macos"
            data-analytics-placement="hero"
        >
            <span
                class="inline-flex translate-x-0 items-center gap-2.5 transition duration-300 ease-out group-hover:-translate-x-8"
            >
                <span
                    class="shrink-0 translate-x-0 opacity-100 transition duration-300 ease-out group-hover:-translate-x-full group-hover:scale-x-50 group-hover:opacity-0 group-hover:blur-sm"
                >
                    <img
                        class="block h-[25px] w-[19px] -translate-y-[3px] object-contain"
                        src={site.assets.appleIcon}
                        alt=""
                    />
                </span>
                <span>Download for Mac</span>
            </span>
            <svg
                class="pointer-events-none absolute right-7 size-6 translate-x-full scale-x-50 opacity-0 blur-sm transition duration-300 ease-out group-hover:translate-x-0 group-hover:scale-x-100 group-hover:opacity-100 group-hover:blur-none"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
            >
                <path
                    d="M5 12h14m-6-6 6 6-6 6"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
            </svg>
        </a>

        <a
            class={`${buttonBase} border-2 border-[#1041c7] bg-white/20 text-[#1041c7] max-[529px]:w-full`}
            href={site.githubUrl}
            data-analytics-event="github_button_clicked"
            data-analytics-target="github"
            data-analytics-placement="hero"
        >
            <span
                class="inline-flex translate-x-0 items-center gap-2.5 transition duration-300 ease-out group-hover:-translate-x-8"
            >
                <span
                    class="shrink-0 translate-x-0 opacity-100 transition duration-300 ease-out group-hover:-translate-x-full group-hover:scale-x-50 group-hover:opacity-0 group-hover:blur-sm"
                >
                    <img
                        class="block size-[22px] object-contain"
                        src={site.assets.githubIcon}
                        alt=""
                    />
                </span>
                <span>View on GitHub</span>
            </span>
            <svg
                class="pointer-events-none absolute right-7 size-6 translate-x-full scale-x-50 opacity-0 blur-sm transition duration-300 ease-out group-hover:translate-x-0 group-hover:scale-x-100 group-hover:opacity-100 group-hover:blur-none"
                viewBox="0 0 24 24"
                fill="none"
                aria-hidden="true"
            >
                <path
                    d="M5 12h14m-6-6 6 6-6 6"
                    stroke="currentColor"
                    stroke-width="2"
                    stroke-linecap="round"
                    stroke-linejoin="round"></path>
            </svg>
        </a>
    </div>

    <div
        class="relative mt-4 w-[min(80vw,1440px)] max-[1500px]:w-[90vw] max-[900px]:w-full sm:mt-14"
    >
        <MacDesktopDemo />
    </div>
</section>
